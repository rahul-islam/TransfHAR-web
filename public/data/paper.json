  "findings": [
    {
      "title": "Coarse motion transfers to fine-grained activity",
      "body": "Pretraining only on L1/L2 activities (sitting, walking, exercise) yields a frozen encoder that beats fully supervised pipelines on held-out L3 and L4 benchmarks.",
      "link": "datasets"
    },
    {
      "title": "Freeze, don't fine-tune",
      "body": "With identical architecture, a frozen encoder + linear probe beats full fine-tuning on all three benchmarks, and training from scratch falls far behind.",
      "link": "models"
    },
    {
      "title": "The gyroscope matters",
      "body": "The 6-axis encoder beats the 3-axis one at nearly every supervision level, despite a smaller pretraining corpus. The gap is widest on SAMoSA and at one shot.",
      "link": "models"
    },
    {
      "title": "Five shots gets most of the way",
      "body": "In the user study, accuracy jumps from 75.2% at K=1 to 86.7% at K=5. By K=20 it is within 1.1 pp of the full one-minute session.",
      "link": "study"
    },
    {
      "title": "Procedures need temporal context",
      "body": "PrISM procedural steps stay hard (36.5% on latte-making) because steps look alike within a 2.56 s window. Only PrISM benefits from longer 5.12 s windows.",
      "link": "models"
    },
    {
      "title": "Failures are sustained, low-amplitude motions",
      "body": "Writing, phone scrolling, and applying lotion collapse into a shared embedding region. More examples don't fix genuinely overlapping wrist motion.",
      "link": "study"
    }
  ]
}
